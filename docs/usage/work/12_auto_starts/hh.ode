par I=8.0,vna=50,vk=-77,vl=-54.4,gna=120,gk=36,gl=0.3,c=1
am(v)=.1*(v+40)/(1-exp(-(v+40)/10))
bm(v)=4*exp(-(v+65)/18)
ah(v)=.07*exp(-(v+65)/20)
bh(v)=1/(1+exp(-(v+35)/10))
an(v)=.01*(v+55)/(1-exp(-(v+55)/10))
bn(v)=.125*exp(-(v+65)/80)
v'=(I - gna*h*(v-vna)*m^3 - gk*(v-vk)*n^4 - gl*(v-vl))/c
m'=am(v)*(1-m) - bm(v)*m
h'=ah(v)*(1-h) - bh(v)*h
n'=an(v)*(1-n) - bn(v)*n
init v=-65,m=0.053,h=0.596,n=0.318
@ total=300,dt=0.01,meth=rungekutta,maxstor=100000
done
